"""Pass one shared model profile to an existing node entrypoint."""

import json
import os
from pathlib import Path
import sys

from model_config import load_profile, node_configuration


def main():
    if len(sys.argv) < 2:
        raise SystemExit("Usage: model-node NODE [NODE_OPTIONS...]")
    profile = load_profile()
    args, env = node_configuration(sys.argv[1], sys.argv[2:], profile)
    report_dir = env.get("OPENARM_MODEL_REPORT_DIR")
    if report_dir:
        directory = Path(report_dir)
        directory.mkdir(parents=True, exist_ok=True)
        report = profile.report()
        report.update(command=args, entrypoint=sys.argv[1])
        (directory / (sys.argv[1] + ".json")).write_text(
            json.dumps(report, indent=2) + "\n"
        )
    print(
        f"Model {profile.name}: {profile.xml} (keyframe={profile.settings['keyframe']})",
        flush=True,
    )
    os.execvpe(args[0], args, env)


if __name__ == "__main__":
    main()
